# Docker Compose (container do PostgreSQL)
POSTGRES_USER=pedidos
POSTGRES_PASSWORD=pedidos
POSTGRES_DB=pedidos
POSTGRES_PORT=5433

# Aplicação
DATABASE_URL=postgresql://pedidos:pedidos@localhost:5433/pedidos

# WhatsApp que recebe os pedidos (opcional; só dígitos, com DDI+DDD, ex.: 5511999998888).
# Em branco: o link do pedido abre o WhatsApp para escolher o contato.
WHATSAPP_ORDERS_NUMBER=
