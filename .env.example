# Docker Compose (container do PostgreSQL)
POSTGRES_USER=pedidos
POSTGRES_PASSWORD=pedidos
POSTGRES_DB=pedidos
POSTGRES_PORT=5433

# Aplicação
DATABASE_URL=postgresql://pedidos:pedidos@localhost:5433/pedidos

# --- Produção: Vercel + Supabase (passo a passo em DEPLOY.md) ---
# Na Vercel essas variáveis são cadastradas no painel do projeto, não neste arquivo.
# DATABASE_URL = "Transaction pooler" do Supabase (porta 6543):
#   postgresql://postgres.<ref-do-projeto>:<senha>@<host-do-pooler>:6543/postgres
# DIRECT_URL = só para as migrações (npm run db:migrate): "Session pooler" (porta 5432).
#   Em branco: as migrações usam a DATABASE_URL (o caso do PostgreSQL local).
# DIRECT_URL=
# DATABASE_SSL_CA = (opcional) certificado da CA do Supabase, para o app VALIDAR o servidor.
#   Sem ele, a conexão com um host remoto é criptografada, mas sem validar o certificado.
# DATABASE_SSL_CA=

# WhatsApp que recebe os pedidos (opcional; só dígitos, com DDI+DDD, ex.: 5511999998888).
# Em branco: o link do pedido abre o WhatsApp para escolher o contato.
WHATSAPP_ORDERS_NUMBER=
